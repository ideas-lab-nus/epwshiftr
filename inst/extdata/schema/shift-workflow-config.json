{
  "check": {"kind": "list"},
  "keys": {
    "type": "named",
    "must.include": ["version", "epw", "climate", "periods", "dir"],
    "subset.of": ["version", "epw", "climate", "periods", "transform", "reference", "observed_reference", "dir", "control", "methods", "calibration"]
  },
  "fields": {
    "version": {"check": {"kind": "count", "positive": true}},
    "epw": {"check": {"kind": "string"}},
    "climate": {
      "check": {"kind": "list"},
      "keys": {
        "type": "named",
        "must.include": ["provider", "model", "scenarios"],
        "subset.of": ["provider", "model", "scenarios", "member", "grid", "frequency", "table", "activity", "index_nodes", "data_node", "filters"]
      },
      "fields": {
        "provider": {"check": {"kind": "choice", "choices": ["cmip6"]}},
        "model": {
          "any": [
            {"check": {"kind": "count", "positive": true}},
            {"check": {"kind": "character", "min.len": 1, "any.missing": false, "unique": true}},
            {"check": {"kind": "null"}}
          ]
        },
        "scenarios": {"check": {"kind": "character", "any.missing": false}},
        "member": {"check": {"kind": "character", "any.missing": false, "null.ok": true}},
        "grid": {"check": {"kind": "string", "null.ok": true}},
        "frequency": {
          "any": [
            {"check": {"kind": "null"}},
            {"check": {"kind": "string"}},
            {"check": {"kind": "list"}, "keys": {"type": "named"}, "rest": {"check": {"kind": "string"}}}
          ]
        },
        "table": {
          "any": [
            {"check": {"kind": "null"}},
            {"check": {"kind": "string"}},
            {"check": {"kind": "list"}, "keys": {"type": "named"}, "rest": {"check": {"kind": "string"}}}
          ]
        },
        "activity": {"check": {"kind": "string"}},
        "index_nodes": {"check": {"kind": "character", "any.missing": false, "null.ok": true}},
        "data_node": {"check": {"kind": "string", "null.ok": true}},
        "filters": {"check": {"kind": "list"}, "keys": {"type": "named"}}
      }
    },
    "periods": {"check": {"kind": "list"}, "keys": {"type": "named"}},
    "transform": {
      "any": [
        {
          "check": {"kind": "list"},
          "keys": {"type": "named", "must.include": ["scale", "method"], "subset.of": ["scale", "method", "reconstruction", "options"]},
          "fields": {
            "scale": {"check": {"kind": "choice", "choices": ["monthly", "daily", "hourly"]}},
            "method": {"check": {"kind": "string"}},
            "reconstruction": {"check": {"kind": "string"}},
            "options": {"check": {"kind": "list"}, "keys": {"type": "named"}}
          }
        },
        {
          "check": {"kind": "list", "min.len": 1},
          "keys": {"type": "unnamed"},
          "rest": {
            "check": {"kind": "list"},
            "keys": {"type": "named", "must.include": ["scale", "method"], "subset.of": ["scale", "method", "reconstruction", "options"]},
            "fields": {
              "scale": {"check": {"kind": "choice", "choices": ["monthly", "daily", "hourly"]}},
              "method": {"check": {"kind": "string"}},
              "reconstruction": {"check": {"kind": "string"}},
              "options": {"check": {"kind": "list"}, "keys": {"type": "named"}}
            }
          }
        }
      ]
    },
    "reference": {
      "any": [
        {"check": {"kind": "null"}},
        {
          "check": {"kind": "list"},
          "keys": {
            "type": "named",
            "must.include": ["mode", "periods"],
            "subset.of": ["mode", "periods", "plan_id", "experiment", "activity", "match", "filters", "options"]
          },
          "fields": {
            "mode": {"check": {"kind": "choice", "choices": ["historical", "plan"]}},
            "periods": {"check": {"kind": "list"}, "keys": {"type": "named"}},
            "plan_id": {"check": {"kind": "character", "any.missing": false}},
            "experiment": {"check": {"kind": "string"}},
            "activity": {"check": {"kind": "string"}},
            "match": {"check": {"kind": "character", "any.missing": false}},
            "filters": {"check": {"kind": "list"}, "keys": {"type": "named"}},
            "options": {"check": {"kind": "list"}, "keys": {"type": "named"}}
          }
        }
      ]
    },
    "observed_reference": {
      "any": [
        {"check": {"kind": "null"}},
        {
          "check": {"kind": "list"},
          "keys": {"type": "named", "must.include": ["mode", "periods", "plan_id"], "subset.of": ["mode", "periods", "plan_id"]},
          "fields": {
            "mode": {"check": {"kind": "choice", "choices": ["plan"]}},
            "periods": {"check": {"kind": "list"}, "keys": {"type": "named"}},
            "plan_id": {"check": {"kind": "character", "any.missing": false}}
          }
        },
        {
          "check": {"kind": "list"},
          "keys": {
            "type": "named",
            "must.include": ["dataset", "years"],
            "subset.of": ["mode", "dataset", "years", "product", "variables", "frequency", "access", "options"]
          },
          "fields": {
            "mode": {"check": {"kind": "choice", "choices": ["reanalysis"]}},
            "dataset": {"check": {"kind": "choice", "choices": ["era5", "era6"]}},
            "years": {
              "any": [{"check": {"kind": "string"}}, {"check": {"kind": "integerish", "any.missing": false, "min.len": 1}}]
            },
            "product": {"check": {"kind": "choice", "choices": ["single_levels", "land"]}},
            "variables": {"check": {"kind": "character", "any.missing": false, "unique": true, "null.ok": true}},
            "frequency": {
              "any": [
                {"check": {"kind": "null"}},
                {"check": {"kind": "string"}},
                {"check": {"kind": "list"}, "keys": {"type": "named"}, "rest": {"check": {"kind": "string"}}}
              ]
            },
            "access": {"check": {"kind": "choice", "choices": ["auto", "arco", "cds"]}},
            "options": {
              "check": {"kind": "list"},
              "keys": {"type": "named", "subset.of": ["timeout", "poll_interval"]},
              "fields": {"timeout": {"check": {"kind": "number", "lower": 0}}, "poll_interval": {"check": {"kind": "number", "lower": 0}}}
            }
          }
        }
      ]
    },
    "dir": {"check": {"kind": "string"}},
    "control": {
      "check": {"kind": "list"},
      "keys": {"type": "named", "subset.of": ["strict", "allow_partial", "download", "resume", "overwrite", "extraction_method", "output_layout", "refresh"]},
      "fields": {
        "strict": {"check": {"kind": "flag"}},
        "allow_partial": {"check": {"kind": "flag"}},
        "download": {"check": {"kind": "choice", "choices": ["auto", "always", "never"]}},
        "resume": {"check": {"kind": "flag"}},
        "overwrite": {"check": {"kind": "flag"}},
        "extraction_method": {"check": {"kind": "choice", "choices": ["nearest", "idw", "bilinear", "mean"]}},
        "output_layout": {"check": {"kind": "choice", "choices": ["nested", "flat"]}},
        "refresh": {"check": {"kind": "flag"}}
      }
    },
    "methods": {"check": {"kind": "character", "min.len": 1, "any.missing": false, "unique": true}},
    "calibration": {
      "any": [
        {"check": {"kind": "null"}},
        {
          "check": {"kind": "list"},
          "keys": {"type": "named", "must.include": ["mode", "periods", "plan_id"], "subset.of": ["mode", "periods", "plan_id"]},
          "fields": {
            "mode": {"check": {"kind": "choice", "choices": ["plan"]}},
            "periods": {"check": {"kind": "list"}, "keys": {"type": "named"}},
            "plan_id": {"check": {"kind": "character", "any.missing": false}}
          }
        },
        {
          "check": {"kind": "list"},
          "keys": {
            "type": "named",
            "must.include": ["dataset", "years"],
            "subset.of": ["mode", "dataset", "years", "product", "variables", "frequency", "access", "options"]
          },
          "fields": {
            "mode": {"check": {"kind": "choice", "choices": ["reanalysis"]}},
            "dataset": {"check": {"kind": "choice", "choices": ["era5", "era6"]}},
            "years": {
              "any": [{"check": {"kind": "string"}}, {"check": {"kind": "integerish", "any.missing": false, "min.len": 1}}]
            },
            "product": {"check": {"kind": "choice", "choices": ["single_levels", "land"]}},
            "variables": {"check": {"kind": "character", "any.missing": false, "unique": true, "null.ok": true}},
            "frequency": {
              "any": [
                {"check": {"kind": "null"}},
                {"check": {"kind": "string"}},
                {"check": {"kind": "list"}, "keys": {"type": "named"}, "rest": {"check": {"kind": "string"}}}
              ]
            },
            "access": {"check": {"kind": "choice", "choices": ["auto", "arco", "cds"]}},
            "options": {
              "check": {"kind": "list"},
              "keys": {"type": "named", "subset.of": ["timeout", "poll_interval"]},
              "fields": {"timeout": {"check": {"kind": "number", "lower": 0}}, "poll_interval": {"check": {"kind": "number", "lower": 0}}}
            }
          }
        }
      ]
    }
  }
}
