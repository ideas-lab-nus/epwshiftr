{
  "check": {"kind": "list"},
  "keys": {
    "type": "named",
    "must.include": ["version", "epw", "climate", "periods", "method", "dir"],
    "subset.of": ["version", "epw", "climate", "periods", "method", "dir", "control"]
  },
  "fields": {
    "version": {"check": {"kind": "count", "positive": true}},
    "epw": {"check": {"kind": "string"}},
    "climate": {
      "check": {"kind": "list"},
      "keys": {
        "type": "named",
        "must.include": ["provider", "model", "scenarios"],
        "subset.of": ["provider", "model", "scenarios", "member", "grid", "frequency", "table", "activity", "index_nodes", "data_node", "filters"]
      },
      "fields": {
        "provider": {"check": {"kind": "choice", "choices": ["cmip6"]}},
        "model": {"check": {"kind": "character", "any.missing": false}},
        "scenarios": {"check": {"kind": "character", "any.missing": false}},
        "member": {"check": {"kind": "character", "any.missing": false, "null.ok": true}},
        "grid": {"check": {"kind": "string", "null.ok": true}},
        "frequency": {"check": {"kind": "string"}},
        "activity": {"check": {"kind": "string"}},
        "index_nodes": {"check": {"kind": "character", "any.missing": false, "null.ok": true}},
        "data_node": {"check": {"kind": "string", "null.ok": true}},
        "filters": {"check": {"kind": "list"}, "keys": {"type": "named"}}
      }
    },
    "periods": {
      "check": {"kind": "list"},
      "keys": {"type": "named"}
    },
    "method": {
      "check": {"kind": "list"},
      "keys": {
        "type": "named",
        "must.include": ["name"],
        "subset.of": ["name", "profile", "options", "methods", "reference"]
      },
      "fields": {
        "name": {"check": {"kind": "string"}},
        "profile": {"check": {"kind": "choice", "choices": ["enhanced", "legacy"]}},
        "options": {"check": {"kind": "list"}, "keys": {"type": "named"}},
        "methods": {"check": {"kind": "list"}, "keys": {"type": "named"}},
        "reference": {
          "check": {"kind": "list", "null.ok": true},
          "keys": {
            "type": "named",
            "must.include": ["mode", "periods"],
            "subset.of": ["mode", "periods", "plan_id", "experiment", "activity", "match", "filters", "options"]
          },
          "fields": {
            "mode": {"check": {"kind": "choice", "choices": ["historical", "plan"]}},
            "periods": {"check": {"kind": "list"}, "keys": {"type": "named"}},
            "plan_id": {"check": {"kind": "character", "any.missing": false}},
            "experiment": {"check": {"kind": "string"}},
            "activity": {"check": {"kind": "string"}},
            "match": {"check": {"kind": "character", "any.missing": false}},
            "filters": {"check": {"kind": "list"}, "keys": {"type": "named"}},
            "options": {"check": {"kind": "list"}, "keys": {"type": "named"}}
          }
        }
      }
    },
    "dir": {"check": {"kind": "string"}},
    "control": {
      "check": {"kind": "list"},
      "keys": {
        "type": "named",
        "subset.of": ["strict", "allow_partial", "download", "resume", "overwrite", "extraction_method", "output_layout"]
      },
      "fields": {
        "strict": {"check": {"kind": "flag"}},
        "allow_partial": {"check": {"kind": "flag"}},
        "download": {"check": {"kind": "choice", "choices": ["auto", "always", "never"]}},
        "resume": {"check": {"kind": "flag"}},
        "overwrite": {"check": {"kind": "flag"}},
        "extraction_method": {"check": {"kind": "choice", "choices": ["nearest", "idw", "bilinear", "mean"]}},
        "output_layout": {"check": {"kind": "choice", "choices": ["nested", "flat"]}}
      }
    }
  }
}
