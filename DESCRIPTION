Package: epwshiftr
Title: Create Future 'EnergyPlus' Weather Files using 'CMIP6' Data
Version: 0.1.4.9001
Authors@R: c(
    person(given = "Hongyuan",
           family = "Jia",
           role = c("aut", "cre"),
           email = "hongyuanjia@outlook.com",
           comment = c(ORCID = "0000-0002-0075-8183")),
    person(given = "Adrian",
